# ── Required ──────────────────────────────────────────────
# Password used to log into the web UI (change it!)
APP_PASSWORD=change-me-please

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# ── Optional: direct Google Vertex AI calls (models "vertex:<model>") ──────
# 1. Create/select a GCP project, enable the "Vertex AI API".
# 2. IAM & Admin → Service Accounts → create one with role "Vertex AI User".
# 3. Create a JSON key for it and paste its whole content below (one line).
# GOOGLE_PROJECT_ID=my-gcp-project
# GOOGLE_LOCATION=us-central1
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
# (or mount a key file and use this instead of the line above)
# GOOGLE_SERVICE_ACCOUNT_FILE=/app/data/gcp-key.json

# ── Optional: AWS Bedrock direct calls (models "bedrock:<model>") ─────────
# 1. IAM → Users → create one with policy "AmazonBedrockFullAccess" (or a
#    scoped-down InvokeModel-only policy).
# 2. Security credentials → create an access key (type: "Application running
#    outside AWS" / CLI).
# 3. In the Bedrock console, request access to the Anthropic Claude models
#    you want to use (Model access page) — approval is usually instant.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── Optional: any OpenAI-compatible gateway (models "custom:<model>") ─────
# Point this at FastRouter, a self-hosted vLLM/Ollama/LM Studio, or any other
# OpenAI-compatible endpoint and call its models as "custom:<id>", e.g.
# "custom:z-ai/glm-5.3-flash". When CUSTOM_BASE_URL is set, the gateway's
# /models catalog also shows up in the picker with "custom:" prefixed ids.
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=https://api.fastrouter.ai/v1
# CUSTOM_DEFAULT_MODEL=            <- optional, prepended to the picker list

# ── Optional ──────────────────────────────────────────────
# SQLite database file (Docker mounts ./data into the container)
# DATABASE_URL=sqlite:///./data/batch_chat.db

# Session lifetime in days
# TOKEN_EXPIRE_DAYS=30

# Port the app listens on (inside the container it is always 8000)
# PORT=8000

# CORS origins allowed to call the API (comma-separated). Default "*" keeps
# phone/PC clients working over LAN IPs; set your domain when behind HTTPS.
# CORS_ORIGINS=*

# Cache keep-alive: hours to keep the 1-hour prompt cache warm with near-empty
# pings after the last chat (0 = off). Only applies when CACHE_DURATION_SECONDS
# is 3600. Default 3.
# CACHE_KEEPALIVE_HOURS=3
# --- TLS (Let's Encrypt for a bare IP) ---
# The public IP this server is reached at; used by scripts/renew-tls.sh
# (cert issuance/renewal). No IP is hardcoded in scripts.
# --- Public URLs & TLS ---
# Primary public address (used in e-mail links, OAuth redirects, pairing codes)
PUBLIC_BASE_URL=https://chat.example.com
# Server IP (used for the IP SAN in the TLS certificate and by renew-tls.sh)
SERVER_IP=
# Domain names included in the TLS certificate (space-separated; optional).
# If set together with SERVER_IP, ONE certificate covers domains + IP.
TLS_DOMAINS=chat.example.com www.chat.example.com

# --- Google OAuth sign-in (optional; buttons stay disabled until set) ---
# Redirect URI to register in Google Cloud Console:
#   {PUBLIC_BASE_URL}/api/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- E-mail delivery (Gmail SMTP relay) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx   <- 16-char App Password, not the login password
# SMTP_FROM=you@gmail.com

