# ── Required ──────────────────────────────────────────────
# Password used to log into the web UI (change it!)
APP_PASSWORD=change-me-please

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# ── Optional ──────────────────────────────────────────────
# SQLite database file (Docker mounts ./data into the container)
# DATABASE_URL=sqlite:///./data/batch_chat.db

# Session lifetime in days
# TOKEN_EXPIRE_DAYS=30

# Port the app listens on (inside the container it is always 8000)
# PORT=8000